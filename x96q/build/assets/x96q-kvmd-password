#!/bin/bash
# x96q-kvmd-password <new-password> [user]
# Recreates the kvmd container with new web UI credentials (~30 s of downtime).
set -e
NEW=${1:-}
USER_NAME=${2:-}
[ -n "$NEW" ] || {
    echo "usage: x96q-kvmd-password <new-password> [user]"
    exit 1
}
case "$NEW" in
*[!A-Za-z0-9]*) echo "use letters and digits only (docker env safe)"; exit 1 ;;
esac

F=/root/.x96q-credentials
if [ -z "$USER_NAME" ] && [ -r "$F" ]; then
    USER_NAME=$(sed -n 's/^KVMD_USER=//p' "$F" | head -1)
fi
USER_NAME=${USER_NAME:-admin}

WEBUSER="$USER_NAME" WEBPASS="$NEW" /usr/local/sbin/x96q-kvmd-otg.sh

if [ -w "$F" ]; then
    sed -i "s|^KVMD_USER=.*|KVMD_USER=$USER_NAME|; s|^KVMD_PASSWORD=.*|KVMD_PASSWORD=$NEW|" "$F"
    chmod 600 "$F"
fi
echo "kvmd web credentials updated: $USER_NAME"
